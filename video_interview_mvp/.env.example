# Ключи опциональны: без них приложение работает на заглушках, но оценка
# кандидата в этом режиме ненастоящая — на демо так показывать нельзя.

# --- LLM: разбор вакансии, генерация вопросов, оценка ответов, заключение ---
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Основная модель: разбор вакансии, генерация вопросов, итоговое заключение
LLM_MODEL=google/gemini-3.8-flash
# Быстрая модель для шагов во время интервью: оценка ответа, решение об
# уточняющем вопросе, очистка расшифровки. Отвечает за ~1.5 с вместо ~9 с.
LLM_MODEL_FAST=google/gemini-3.1-flash-lite

# --- Транскрибация ответов кандидата (Deepgram nova-3, русский) ---
DEEPGRAM_API_KEY=

# --- Озвучка вопросов живым голосом (Cartesia Sonic) ---
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-3
# Natalya - Soothing Guide, спокойный женский русский голос
CARTESIA_VOICE_ID=779673f3-895f-4935-b6b5-b031dc78b319

# Общих регистрационных ключей нет: первый аккаунт становится владельцем
# воркспейса, дальше HR выдаёт одноразовые приглашения из интерфейса.
